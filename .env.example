# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""
# Model used for telemetry analysis. Configure explicitly; the application does not select a model in code.
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MONGODB_URI: Connection string for MongoDB database
MONGODB_URI=""

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET=""

# Initial Admin credentials (optional bootstrap)
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# CORS_ORIGINS: Allowed origins for CORS (comma-separated, optional)
CORS_ORIGINS=""

# APERTURE_RFID_HOST / BEECEPTOR_MOCK_URL / GAO_DEVICE_API_KEY: Configuration for RFID readers and gateways
APERTURE_RFID_HOST=""
BEECEPTOR_MOCK_URL=""
APERTURE_RFID_API_KEY=""
GAO_DEVICE_API_KEY=""

# GAO216031A Reader Mode: "mock" (development) or "real" (physical hardware)
# GAO documented defaults: IP=192.168.1.116, Port=9090, Mode=TCP_SERVER
GAO_READER_MODE=mock
GAO_READER_IP=192.168.1.116
GAO_READER_PORT=9090

# GAO216031A Mock Simulator
# Set GAO_SIMULATOR_ENABLED=true to auto-start the simulator on server launch
# GAO_SIMULATOR_INTERVAL_MS controls how often the simulator generates RFID reads
GAO_SIMULATOR_ENABLED=false
GAO_SIMULATOR_INTERVAL_MS=500
